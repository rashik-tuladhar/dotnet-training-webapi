  "components": {
    "schemas": {
      "AuthorDetails": {
        "required": [
          "bio",
          "dateOfBirth",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "authorId": {
            "type": "integer",
            "format": "int32"
          },
          "authorIdString": {
            "type": "string",
            "nullable": true
          },
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "middleName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "minLength": 1,
            "type": "string"
          },
          "bio": {
            "minLength": 1,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookDetails": {
        "required": [
          "author",
          "availableCopies",
          "category",
          "edition",
          "isbn",
          "name",
          "publication",
          "totalCopies"
        ],
        "type": "object",
        "properties": {
          "bookId": {
            "type": "integer",
            "format": "int32"
          },
          "bookIdString": {
            "type": "string",
            "nullable": true
          },
          "name": {
